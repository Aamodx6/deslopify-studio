---
import Layout from '../../layouts/Layout.astro';
import workData from '../../data/work.json';

const categories = ['All', 'Workflow Automation', 'Support', 'Document Intelligence', 'Analytics'];
---

<Layout
  title="Our Work & Case Studies | Deslopify Studio"
  description="Proven case studies of production AI engineering, workflow automation, and application glow-ups."
>
  <div class="subpage-container">
    <div class="page-hero">
      <span class="page-badge">Featured Case Studies</span>
      <h1 class="page-title">
        Real Production Systems.<br>
        <span class="gradient-text">Verified Client Outcomes.</span>
      </h1>
      <p class="page-subtitle">
        Explore how we turned slow, fragile, and ugly applications into high-converting investor-grade software.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="portfolio-filters" id="work-filters">
      {categories.map((cat, i) => (
        <button
          class={`filter-btn ${i === 0 ? 'active' : ''}`}
          data-category={cat}
          type="button"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Portfolio Grid with Strict Card Flex Baseline -->
    <div class="portfolio-grid" id="portfolio-grid">
      {workData.map((project) => (
        <div class="portfolio-card" data-category={project.category}>
          <div class="portfolio-thumb-wrap">
            <span class="portfolio-badge-cat">{project.category}</span>
            <img src={project.heroImage} alt={project.title} loading="lazy" />
          </div>

          <div class="portfolio-content">
            <h3 class="portfolio-title">{project.title}</h3>
            <p class="portfolio-tagline">{project.tagline}</p>

            <div class="portfolio-metrics-row">
              {project.metrics.slice(0, 2).map((m) => (
                <div>
                  <div class="portfolio-metric-val">{m.value}</div>
                  <div class="portfolio-metric-label">{m.label}</div>
                </div>
              ))}
            </div>

            <div class="portfolio-card-footer">
              <span class="portfolio-client">{project.client}</span>
              <a class="portfolio-cta-btn" href={`/work/${project.slug}`}>
                Case Study
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Inquiry Callout -->
    <div style="margin-top: 80px; text-align: center; background: #f8f9fe; border-radius: 20px; padding: 40px; border: 1px solid #e7ebf7;">
      <h3 style="font-family: var(--jakarta); font-size: 24px; font-weight: 800; color: var(--ink-heading); margin-bottom: 10px;">Have a specific workflow or app in mind?</h3>
      <p style="font-size: 15px; color: var(--gray); max-width: 500px; margin: 0 auto 24px;">Send us your architecture diagram, wireframes, or legacy screens for a free technical proposal.</p>
      <a class="submit-btn-primary" href="/contact-us" style="max-width: 260px; margin: 0 auto;">
        Request Custom Proposal
      </a>
    </div>
  </div>
</Layout>

<script>
  // Interactive Portfolio Category Filter
  const filterBtns = document.querySelectorAll('#work-filters .filter-btn');
  const cards = document.querySelectorAll('#portfolio-grid .portfolio-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedCategory = btn.getAttribute('data-category');

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (selectedCategory === 'All' || cardCategory === selectedCategory) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
