---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Screen Not Found | Deslopify Studio"
  description="The screen or page you are looking for has been deslopified, moved, or does not exist."
>
  <div class="subpage-container" style="text-align: center; min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <span class="page-badge" style="color: #ef4444; background: #fee2e2; border-color: #fecaca;">
      HTTP Error 404
    </span>
    
    <h1 class="page-title" style="margin-top: 14px;">
      This Screen Has Been<br>
      <span class="gradient-text">Deslopified Out of Existence.</span>
    </h1>
    
    <p class="page-subtitle" style="margin-bottom: 36px;">
      The route you requested could not be found. Perhaps it was a legacy float layout that collapsed into oblivion. Let's get you back on track.
    </p>

    <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
      <a class="submit-btn-primary" href="/" style="width: auto; padding: 14px 28px;">
        Return to Homepage
      </a>
      <a class="filter-btn" href="/work" style="padding: 14px 24px; font-size: 15px; border-radius: 12px;">
        Explore Case Studies
      </a>
      <a class="filter-btn" href="/services" style="padding: 14px 24px; font-size: 15px; border-radius: 12px;">
        View Services Catalog
      </a>
    </div>
  </div>
</Layout>
