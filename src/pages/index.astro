---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import IntelligenceStage from '../components/IntelligenceStage.astro';
import ShowcaseSection from '../components/ShowcaseSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import BentoSection from '../components/BentoSection.astro';
import PricingSection from '../components/PricingSection.astro';
import AboutCardSection from '../components/AboutCardSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Deslopify | Ugly App In. Beautiful App Out."
  description="Send screenshots or rough specs of your app. Get back investor-ready interfaces, AI workflows, and coded prototypes in days, not months."
>
  <div class="canvas">
    <!-- Hero Zone with Halo, Claude Coded Badge, and Interactive Phone Tickers -->
    <Hero />

    <!-- Truthful Metrics & Verification Bar -->
    <Metrics />

    <!-- Before and After iPhone Stage -->
    <IntelligenceStage />

    <!-- Showcase with Pill Toggle & App Switcher -->
    <ShowcaseSection />

    <!-- Core Services & Capabilities Grid -->
    <ServicesSection />

    <!-- 3-Step Interactive Process Walkthrough -->
    <ProcessSection />

    <!-- Detailed Bento Feature Grid -->
    <BentoSection />

    <!-- Transparent Pricing Configurator & Unfold Gallery -->
    <PricingSection />

    <!-- Team & Philosophy Card -->
    <AboutCardSection />

    <!-- Founder Testimonial Orbit & Wall of Love -->
    <TestimonialSection />

    <!-- Interactive FAQ Accordion -->
    <FaqSection />
  </div>
</Layout>
