---
import Layout from '../../layouts/Layout.astro';
import blogData from '../../data/blog.json';

export async function getStaticPaths() {
  return blogData.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={`${post.title} | Deslopify Studio Insights`}
  description={post.excerpt}
>
  <div class="subpage-container" style="max-width: 860px;">
    <!-- Breadcrumb -->
    <div style="margin-bottom: 32px;">
      <a href="/blog" style="font-size: 14px; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 6px;">
        ← Back to Insights
      </a>
    </div>

    <!-- Article Header -->
    <div style="margin-bottom: 40px; border-bottom: 1px solid #eef0f8; padding-bottom: 32px;">
      <span class="page-badge">{post.category}</span>
      <h1 class="page-title" style="text-align: left; font-size: clamp(32px, 4.5vw, 48px); margin: 16px 0 20px;">
        {post.title}
      </h1>
      
      <div style="display: flex; align-items: center; gap: 16px; margin-top: 24px;">
        <img src={post.author.avatar} alt={post.author.name} style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;" />
        <div>
          <div style="font-size: 16px; font-weight: 700; color: var(--ink-heading);">{post.author.name}</div>
          <div style="font-size: 13px; color: var(--gray);">{post.author.role} · {post.date} · {post.readTime}</div>
        </div>
      </div>
    </div>

    <!-- Article Body -->
    <article class="blog-post-article">
      <div style="background: #f8f9fe; border-left: 4px solid var(--blue); padding: 20px 24px; border-radius: 0 12px 12px 0; font-size: 17px; font-weight: 600; line-height: 1.6; color: var(--ink); margin-bottom: 36px;">
        {post.excerpt}
      </div>

      {post.content.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <!-- Architectural Callout -->
      <div style="background: #1f1f32; color: #ffffff; border-radius: 16px; padding: 28px; margin: 40px 0;">
        <h4 style="font-family: var(--jakarta); font-size: 18px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">
          The Deslopify Production Guarantee
        </h4>
        <p style="font-size: 14px; line-height: 1.6; color: #d0d4e4; margin: 0;">
          Never compromise between visual elegance and system reliability. Our studio builds deterministic agent architectures wrapped in investor-grade mobile and desktop interfaces.
        </p>
      </div>

      <!-- Author Bio Footer -->
      <div style="margin-top: 60px; padding: 32px; background: #ffffff; border: 1px solid var(--card-gray); border-radius: 20px; display: flex; align-items: center; gap: 20px;">
        <img src={post.author.avatar} alt={post.author.name} style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" />
        <div>
          <h4 style="font-family: var(--jakarta); font-size: 17px; font-weight: 700; color: var(--ink-heading); margin-bottom: 4px;">
            Written by {post.author.name}
          </h4>
          <p style="font-size: 13px; line-height: 1.5; color: var(--gray); margin: 0;">
            {post.author.role} at Deslopify Studio. Working with founders and product teams to modernize AI architectures and user experiences.
          </p>
        </div>
      </div>

      <div style="margin-top: 48px; text-align: center;">
        <a class="submit-btn-primary" href="/contact-us" style="max-width: 260px; margin: 0 auto;">
          Discuss Your Architecture
        </a>
      </div>
    </article>
  </div>
</Layout>
