---
import Layout from '../../layouts/Layout.astro';
import blogData from '../../data/blog.json';
---

<Layout
  title="Engineering Insights & Thought Leadership | Deslopify Studio"
  description="Deep dives into AI systems architecture, deterministic agent workflows, latency budgets, and the death of software slop."
>
  <div class="subpage-container">
    <div class="page-hero">
      <span class="page-badge">Engineering & Design Insights</span>
      <h1 class="page-title">
        Architectural Deep Dives.<br>
        <span class="gradient-text">Zero Industry Fluff.</span>
      </h1>
      <p class="page-subtitle">
        Hard-won technical lessons on turning fragile AI prototypes into bulletproof, high-speed production systems.
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="blog-grid" style="margin-bottom: 80px;">
      {blogData.map((post) => (
        <article class="blog-card">
          <div class="blog-card-cat">{post.category} · {post.readTime}</div>
          <h2 class="blog-card-title">
            <a href={`/blog/${post.slug}`} style="color: inherit;">
              {post.title}
            </a>
          </h2>
          <p class="blog-card-excerpt">{post.excerpt}</p>

          <div class="blog-card-footer">
            <div class="blog-author-block">
              <img class="blog-author-avatar" src={post.author.avatar} alt={post.author.name} />
              <div class="blog-author-info">
                <span class="blog-author-name">{post.author.name}</span>
                <span class="blog-date-text">{post.date}</span>
              </div>
            </div>

            <a href={`/blog/${post.slug}`} style="font-size: 13px; font-weight: 700; color: var(--blue); display: inline-flex; align-items: center; gap: 4px;">
              Read →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Newsletter / Subscribe Callout -->
    <div style="background: #f8f9fe; border: 1px solid #e2e5f5; border-radius: 24px; padding: 48px; text-align: center; max-width: 720px; margin: 0 auto;">
      <h3 style="font-family: var(--jakarta); font-size: 24px; font-weight: 800; color: var(--ink-heading); margin-bottom: 10px;">
        Subscribe to our bi-weekly architecture dispatches
      </h3>
      <p style="font-size: 15px; color: var(--gray); margin-bottom: 24px;">
        No promotional spam. Just production postmortems, latency benchmark scripts, and Claude design tokens.
      </p>
      <form id="newsletter-form" style="display: flex; gap: 10px; max-width: 440px; margin: 0 auto; flex-wrap: wrap;">
        <input type="email" placeholder="founder@company.com" required style="flex-grow: 1; padding: 12px 16px; border-radius: 10px; border: 1px solid #d2d6e6; outline: none; font-size: 14px;" />
        <button type="submit" class="submit-btn-primary" style="padding: 12px 20px; width: auto; font-size: 14px;">
          Join Dispatch
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  const newsletterForm = document.getElementById('newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Subscribed! Check your inbox.');
    });
  }
</script>
