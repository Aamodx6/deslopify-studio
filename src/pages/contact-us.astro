---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Book a Project Review | Deslopify Studio"
  description="Schedule an architecture review or request a project proposal from Deslopify Studio. Fast turnaround guaranteed."
>
  <div class="subpage-container">
    <div class="page-hero">
      <span class="page-badge">Start Your Project</span>
      <h1 class="page-title">
        Let&rsquo;s Build Something<br>
        <span class="gradient-text">Exceptional Together.</span>
      </h1>
      <p class="page-subtitle">
        Tell us about your application, rough specs, or current bottlenecks. We respond within 24 hours with an actionable roadmap.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Left: Contact Details & Direct Booking -->
      <div class="contact-info-card">
        <h3 style="font-family: var(--jakarta); font-size: 24px; font-weight: 800; color: var(--ink-heading); margin-bottom: 12px;">
          Direct Access. Zero Bureaucracy.
        </h3>
        <p style="font-size: 15px; line-height: 1.6; color: var(--gray); margin-bottom: 28px;">
          You talk directly with principal engineers and designers who actually write the code and ship the screens.
        </p>

        <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px;">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #eef1ff; color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 18px;">
              ⏱
            </div>
            <div>
              <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Turnaround Response</div>
              <div style="font-size: 15px; font-weight: 700; color: var(--ink-heading);">Within 24 Hours</div>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #eef1ff; color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 18px;">
              💬
            </div>
            <div>
              <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Direct Slack Channel</div>
              <div style="font-size: 15px; font-weight: 700; color: var(--ink-heading);">Private Team Channel on Retainer</div>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #eef1ff; color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 18px;">
              🛡️
            </div>
            <div>
              <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Data & IP Protection</div>
              <div style="font-size: 15px; font-weight: 700; color: var(--ink-heading);">100% Client Code Ownership & Strict NDA</div>
            </div>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid #e1e5f2; border-radius: 16px; padding: 24px; text-align: center;">
          <h4 style="font-family: var(--jakarta); font-size: 17px; font-weight: 700; color: var(--ink-heading); margin-bottom: 6px;">
            Prefer a direct 20-min video call?
          </h4>
          <p style="font-size: 13px; color: var(--gray); margin-bottom: 16px;">
            Pick a time slot directly on our principal calendar.
          </p>
          <a class="filter-btn active" href="#book" style="display: inline-block; width: 100%; text-align: center; padding: 12px; font-size: 14px;">
            Open Live Calendar Slot
          </a>
        </div>
      </div>

      <!-- Right: Interactive Inquiry Form -->
      <div class="contact-form-card">
        <h3 style="font-family: var(--jakarta); font-size: 24px; font-weight: 800; color: var(--ink-heading); margin-bottom: 24px;">
          Project Inquiry Form
        </h3>

        <form id="project-form">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="form-row-2">
            <div class="form-group">
              <label class="form-label" for="full-name">Your Name *</label>
              <input class="form-control" type="text" id="full-name" required placeholder="Alex Vance" />
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Work Email *</label>
              <input class="form-control" type="email" id="email" required placeholder="alex@company.com" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="form-row-2">
            <div class="form-group">
              <label class="form-label" for="company">Company / Studio</label>
              <input class="form-control" type="text" id="company" placeholder="Acme Systems" />
            </div>
            <div class="form-group">
              <label class="form-label" for="website">Current App / Website URL</label>
              <input class="form-control" type="url" id="website" placeholder="https://yourapp.com" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">What do you need help with? (Select all that apply)</label>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px;">
              <label class="budget-chip">
                <input type="checkbox" name="services" value="workflow" checked />
                <span>AI Workflow Automation</span>
              </label>
              <label class="budget-chip">
                <input type="checkbox" name="services" value="support" />
                <span>Customer Support Agents</span>
              </label>
              <label class="budget-chip">
                <input type="checkbox" name="services" value="document" />
                <span>Document Intelligence</span>
              </label>
              <label class="budget-chip">
                <input type="checkbox" name="services" value="modernize" checked />
                <span>UI/UX Modernization</span>
              </label>
              <label class="budget-chip">
                <input type="checkbox" name="services" value="retainer" />
                <span>Monthly Studio Retainer</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Estimated Monthly / Project Budget</label>
            <div class="budget-options">
              <label class="budget-chip">
                <input type="radio" name="budget" value="1k-5k" />
                <span>$1k – $5k (Screens)</span>
              </label>
              <label class="budget-chip">
                <input type="radio" name="budget" value="5k-15k" checked />
                <span>$5k – $15k (Sprint)</span>
              </label>
              <label class="budget-chip">
                <input type="radio" name="budget" value="15k-30k" />
                <span>$15k – $30k (Full System)</span>
              </label>
              <label class="budget-chip">
                <input type="radio" name="budget" value="enterprise" />
                <span>$30k+ (Enterprise)</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="notes">Tell us about your project & bottlenecks *</label>
            <textarea class="form-control" id="notes" required placeholder="What does your app do today? Where is it slow, messy, or dropping conversions?"></textarea>
          </div>

          <button class="submit-btn-primary" type="submit" id="submit-btn">
            Submit Project Inquiry
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>

          <div id="form-success" style="display: none; margin-top: 18px; padding: 16px; border-radius: 12px; background: #eefbf1; border: 1px solid #b7ebd0; color: #15803d; font-size: 14px; text-align: center; font-weight: 600;">
            ✓ Thank you! We received your specs and will reply within 24 hours with an architecture roadmap.
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  if (form && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      (submitBtn as HTMLButtonElement).disabled = true;
      (submitBtn as HTMLElement).style.opacity = '0.6';
      (submitBtn as HTMLElement).textContent = 'Submitting your inquiry...';

      setTimeout(() => {
        form.reset();
        (submitBtn as HTMLElement).style.display = 'none';
        successBox.style.display = 'block';
      }, 700);
    });
  }
</script>
