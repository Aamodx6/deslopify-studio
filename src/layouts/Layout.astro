---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Deslopify | Ugly App In. Beautiful App Out.",
  description = "Practical AI engineering, workflow automation, and investor-ready application modernization. In days, not months."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Deslopify Studio" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate icon" href="/assets/favicon-light.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Fixed Navigation Header -->
    <Header currentPath={currentPath} />

    <!-- Page Content Slot wrapped in page-cover for curtain-reveal footer -->
    <div class="page-cover">
      <main>
        <slot />
      </main>
    </div>

    <!-- Global Footer -->
    <Footer />

    <!-- SVG Filters for Ripple Effect -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="ai-ripple" x="-25%" y="-25%" width="150%" height="150%">
        <feTurbulence id="ai-turb" type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="2" seed="7" result="noise"/>
        <feDisplacementMap id="ai-disp" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </svg>

    <!-- Ambient Glow Halo -->
    <div class="ai-wave" aria-hidden="true"></div>

    <!-- Interactive Client Scripts -->
    <script is:inline src="/script.js"></script>
  </body>
</html>
