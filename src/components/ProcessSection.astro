---
// Process Section with interactive step cycle and floating tech icons
---

<section class="process" id="how">
  <div class="process-sticky">
    <div class="proc-stage" data-step="0">
      <span class="proc-ico pi-claude"><img loading="lazy" decoding="async" src="/assets/claude-icon.png" alt="Claude AI" width="32" height="32"></span>
      <span class="proc-ico pi-app"><img loading="lazy" decoding="async" src="/assets/appstore-icon.svg" alt="App Store" width="32" height="32"></span>
      <span class="proc-ico pi-gpt">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-label="ChatGPT">
          <path fill="#0f0f0f" d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464z"/>
        </svg>
      </span>
      <span class="proc-ico pi-figma">
        <svg viewBox="0 0 38 57" width="24" height="36" aria-label="Figma">
          <path fill="#F24E1E" d="M19 0H9.5a9.5 9.5 0 0 0 0 19H19Z"/>
          <path fill="#FF7262" d="M19 0h9.5a9.5 9.5 0 0 1 0 19H19Z"/>
          <path fill="#A259FF" d="M19 19H9.5a9.5 9.5 0 0 0 0 19H19Z"/>
          <circle fill="#1ABCFE" cx="28.5" cy="28.5" r="9.5"/>
          <path fill="#0ACF83" d="M19 38H9.5A9.5 9.5 0 1 0 19 47.5Z"/>
        </svg>
      </span>

      <div class="proc-phone">
        <div class="proc-screen">
          <img loading="lazy" decoding="async" class="proc-before" src="/assets/screens/hush-chat-before.jpg" alt="Before screen">
          <img loading="lazy" decoding="async" class="proc-after" src="/assets/screens/hush-chat-after.jpg" alt="After screen">
          <div class="proc-scan" aria-hidden="true"></div>
        </div>
        <div class="proc-req">
          <span class="sa-chip">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 3.5h8l3 3v14h-11Z"/><path d="M14 3.5v3.2h3.2M9 11h6M9 14.5h6"/>
            </svg>
            Redesign these screens
          </span>
          <div class="proc-req-lines"><span></span><span></span></div>
        </div>
        <div class="proc-git">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#171515" d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.11.82-.26.82-.577 0-.285-.01-1.04-.016-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.838 1.238 1.838 1.238 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23.957-.266 1.983-.4 3.003-.404 1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.24 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.804 5.625-5.476 5.92.43.372.814 1.103.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 21.796 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <div class="proc-git-text"><strong>yourapp-ai</strong><span>GitHub &middot; main branch</span></div>
        </div>
        <div class="proc-md">
          <div class="proc-md-head">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 3.5h8l3 3v14h-11Z"/><path d="M14 3.5v3.2h3.2M9 11h6M9 14.5h6M9 18h3.5"/>
            </svg>
            <strong>design-tokens.json</strong>
          </div>
          <div class="proc-req-lines"><span></span><span></span><span></span></div>
        </div>
        <div class="proc-testi">
          <div class="proc-testi-head">
            <img loading="lazy" decoding="async" src="/assets/avatars/a56-32.jpg" alt="Aisha M." width="32" height="32">
            <div><strong>Aisha M.</strong><span>Founder, Hush</span></div>
            <em>&#9733;&#9733;&#9733;&#9733;&#9733;</em>
          </div>
          <p>&ldquo;Didn&rsquo;t think our app could look this clean. Live in six days.&rdquo;</p>
        </div>
      </div>

      <div class="proc-pills" aria-hidden="true">
        <span class="proc-thumb"></span>
        <span class="proc-pill" data-i="0">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4M7 9l5-5 5 5M4 20h16"/>
          </svg>
          Send Screens
        </span>
        <span class="proc-pill" data-i="1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4Z"/>
          </svg>
          We Redesign
        </span>
        <span class="proc-pill" data-i="2">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 19l4-4M9 5l10 10M14 4l6 6-8 8-6-6Z"/>
          </svg>
          Ship It
        </span>
      </div>

      <div class="proc-heads">
        <h2 class="proc-h" data-i="0"><span class="lm"><span>Send Your Screens.</span></span><span class="lm"><span>Messy Is Fine.</span></span></h2>
        <h2 class="proc-h" data-i="1"><span class="lm"><span>We Redesign</span></span><span class="lm"><span>Every Single Screen.</span></span></h2>
        <h2 class="proc-h" data-i="2"><span class="lm"><span>Ship It.</span></span><span class="lm"><span>Watch People Notice.</span></span></h2>
      </div>
    </div>
  </div>
</section>
