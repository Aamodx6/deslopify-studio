---
// Intelligence Stage: Interactive iPhone comparison slider (messy slop vs investor-ready design)
---

<section class="intelligence" id="intelligence">
  <div class="intelligence-head">
    <span class="tag">
      <img src="/assets/badge-features.png" alt="" width="14" height="14" />
      Before and After
    </span>
    <h2>From Messy<br><span class="blue">to Money.</span></h2>
  </div>
  
  <div class="intelligence-sticky">
    <div class="iphone-stage">
      <div class="iphone">
        <div class="iphone-screens">
          <div class="screen-warp">
            <img class="iphone-screen screen-old" src="/assets/screens/indus-home-before.jpg" alt="Legacy UI Screen" />
            <img class="iphone-screen screen-new" src="/assets/screens/indus-home-after.jpg" alt="Redesigned High Conversion Screen" />
            <div class="screen-shimmer"></div>
          </div>
        </div>
        
        <img class="iphone-frame" src="/assets/intelligence-frame.png" alt="" onerror="this.style.display='none'" />
        
        <div class="stage-toggle" aria-hidden="true">
          <span class="stage-toggle-thumb"></span>
          <span class="st-item st-left">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 16c2-7 6-9 7-6s-4 8-1 9 6-8 8-6-3 7 2 5"/>
            </svg>
            Design Slop In
          </span>
          <span class="st-item st-right">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
            High Polish Out
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
