---
// Pricing Section with live configurator slider, tiered deliverables, and unfold gallery
---

<section class="pricing-sec" id="pricing">
  <div class="pricing-head">
    <span class="tag">
      <img loading="lazy" decoding="async" src="/assets/badge-features.png" alt="" width="14" height="14" />
      Pricing
    </span>
    <h2>Simple pricing<br><span class="blue">for every stage.</span></h2>
  </div>

  <div class="pricing-cards">
    <!-- Card 1: Pay Per Screen -->
    <div class="plan-card">
      <div class="plan-art plan-art-light" aria-hidden="true">
        <div class="plan-art-clip">
          <video class="plan-art-video" data-vsrc="/assets/plan-art-blue.mp4" poster="/assets/plan-art-blue.jpg" autoplay muted loop playsinline preload="none"></video>
        </div>
        <span class="plan-seal">
          <svg class="seal-shape" viewBox="0 0 100 100" aria-hidden="true">
            <path d="M91.0,50.0 A12.5,12.5 0 0 1 85.5,70.5 A12.5,12.5 0 0 1 70.5,85.5 A12.5,12.5 0 0 1 50.0,91.0 A12.5,12.5 0 0 1 29.5,85.5 A12.5,12.5 0 0 1 14.5,70.5 A12.5,12.5 0 0 1 9.0,50.0 A12.5,12.5 0 0 1 14.5,29.5 A12.5,12.5 0 0 1 29.5,14.5 A12.5,12.5 0 0 1 50.0,9.0 A12.5,12.5 0 0 1 70.5,14.5 A12.5,12.5 0 0 1 85.5,29.5 A12.5,12.5 0 0 1 91.0,50.0 Z" stroke="#fff" stroke-width="6"/>
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
            <rect x="3" y="5" width="12" height="16" rx="2.4"/>
            <path d="M18.5 4h.5A2 2 0 0 1 21 6v11"/>
          </svg>
        </span>
      </div>

      <div class="plan-top">
        <span class="plan-ico">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <rect x="3" y="5" width="12" height="16" rx="2.4"/>
            <path d="M18.5 4h.5A2 2 0 0 1 21 6v11"/>
          </svg>
        </span>
        <div class="plan-name-row">
          <h3>Pay Per Screen</h3>
          <span class="cfg-chip" id="cfg-delivery">7 Days Delivery</span>
        </div>
        <p class="plan-desc">One-off redesigns, priced by screen count. Send screens, get them back polished.</p>
        
        <div class="cfg-priceline">
          <p class="cfg-label" id="cfg-label">1 to 3 Screens</p>
          <p class="cfg-price" id="cfg-price">$390</p>
        </div>
        
        <div class="cfg-slider" id="cfg-slider">
          <div class="cfg-track"></div>
          <span class="cfg-dot" style="--x:0"></span>
          <span class="cfg-dot" style="--x:25"></span>
          <span class="cfg-dot" style="--x:50"></span>
          <span class="cfg-dot" style="--x:75"></span>
          <span class="cfg-dot" style="--x:100"></span>
          <span class="cfg-knob" id="cfg-knob" style="--x:0"></span>
        </div>
        
        <label class="cfg-urgent">
          <span class="cfg-switch"><input type="checkbox" id="cfg-urgent-input"><span class="cfg-switch-ui"></span></span>
          <span class="cfg-urgent-label">Quick delivery (4 days) <em>+$300</em></span>
        </label>
      </div>

      <p class="plan-list-label">What&rsquo;s included</p>
      <div class="plan-list">
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5Z"/><path d="M3 13.5l9 5 9-5"/></svg></span>
          <p>Figma files + working Claude-coded prototype</p>
        </div>
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.9 4.7L18.6 10.6l-4.7 1.9L12 17.2l-1.9-4.7L5.4 10.6l4.7-1.9Z"/></svg></span>
          <p>Cohesive design tokens & CSS system</p>
        </div>
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.6-5.7L21 9"/><path d="M21 4v5h-5"/></svg></span>
          <p>One revision round included per screen</p>
        </div>
      </div>

      <a class="btn-dark btn-block" href="/contact-us?plan=pay-per-screen">
        <span class="btn-dark-label">Revamp my Screens</span>
        <span class="btn-arrow"><img loading="lazy" decoding="async" src="/assets/arrow.png" alt=""><img loading="lazy" decoding="async" src="/assets/arrow.png" alt=""></span>
      </a>
    </div>

    <!-- Card 2: Full Subscription -->
    <div class="plan-card dark">
      <div class="plan-art plan-art-dark" aria-hidden="true">
        <div class="plan-art-clip">
          <video class="plan-art-video" data-vsrc="/assets/plan-art-purple.mp4" poster="/assets/plan-art-purple.jpg" autoplay muted loop playsinline preload="none"></video>
        </div>
        <span class="plan-seal">
          <svg class="seal-shape" viewBox="0 0 100 100" aria-hidden="true">
            <path d="M91.0,50.0 A12.5,12.5 0 0 1 85.5,70.5 A12.5,12.5 0 0 1 70.5,85.5 A12.5,12.5 0 0 1 50.0,91.0 A12.5,12.5 0 0 1 29.5,85.5 A12.5,12.5 0 0 1 14.5,70.5 A12.5,12.5 0 0 1 9.0,50.0 A12.5,12.5 0 0 1 14.5,29.5 A12.5,12.5 0 0 1 29.5,14.5 A12.5,12.5 0 0 1 50.0,9.0 A12.5,12.5 0 0 1 70.5,14.5 A12.5,12.5 0 0 1 85.5,29.5 A12.5,12.5 0 0 1 91.0,50.0 Z" stroke="#fff" stroke-width="6"/>
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </span>
      </div>

      <div class="plan-top">
        <span class="plan-ico">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </span>
        <div class="plan-name-row">
          <h3>Design & AI Retainer</h3>
          <span class="cfg-chip dark">Ongoing Studio</span>
        </div>
        <p class="plan-desc">A senior AI engineer and product designer on tap. Unlimited requests, delivered continuously.</p>

        <div class="sub-price-row">
          <p class="plan-price dark" id="sub-price">$3,499</p>
          <span class="plan-period dark" id="sub-period">/ month</span>
        </div>

        <div class="sub-toggle-wrap">
          <div class="sub-toggle" id="sub-toggle" role="radiogroup" aria-label="Billing cadence">
            <span class="sub-toggle-thumb"></span>
            <button class="st-opt active" data-cadence="monthly" type="button">Monthly</button>
            <button class="st-opt" data-cadence="weekly" type="button">Weekly</button>
          </div>
        </div>
      </div>

      <p class="plan-list-label dark">What&rsquo;s included</p>
      <div class="plan-list dark">
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.828 9.172a4 4 0 1 0 0 5.656 10 10 0 0 0 2.172-2.828 10 10 0 0 1 2.172-2.828 4 4 0 1 1 0 5.656 10 10 0 0 1-2.172-2.828 10 10 0 0 0-2.172-2.828"/></svg></span>
          <p>Unlimited screen requests, one active at a time</p>
        </div>
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <p>Production delivery every 48 hours</p>
        </div>
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
          <p>Private Slack channel & async video reviews</p>
        </div>
        <div class="plan-item">
          <span class="pico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16" rx="1.2"/><rect x="14" y="4" width="4" height="16" rx="1.2"/></svg></span>
          <p>Pause or cancel anytime with zero lock-in</p>
        </div>
      </div>

      <a class="btn-dark btn-block" href="/contact-us?plan=studio-subscription">
        <span class="btn-dark-label">Book an Intro Call</span>
        <span class="btn-arrow"><img src="/assets/arrow.png" alt=""><img src="/assets/arrow.png" alt=""></span>
      </a>
    </div>
  </div>
</section>

<!-- ============ UNFOLD GALLERY ============ -->
<section class="unfold">
  <div class="unfold-sticky">
    <div class="unfold-grid" id="unfold-grid">
      <div class="u-tile" style="left:0px;top:0px" data-s="0.5" data-tx="300" data-ty="150"><img data-src="/assets/gal-a1v.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:240px;top:0px" data-s="0.6" data-tx="124" data-ty="90"><img data-src="/assets/gal-b1.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:480px;top:0px" data-s="0.7" data-tx="0" data-ty="40"><img data-src="/assets/gal-c1.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:720px;top:0px" data-s="0.6" data-tx="-124" data-ty="90"><img data-src="/assets/gal-a2.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:960px;top:0px" data-s="0.5" data-tx="-300" data-ty="150"><img data-src="/assets/gal-b2.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:0px;top:295px" data-s="0.5" data-tx="270" data-ty="0"><img data-src="/assets/gal-c2.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:240px;top:295px" data-s="0.6" data-tx="94" data-ty="0"><img data-src="/assets/gal-a3.jpg" alt="" loading="lazy"></div>
      <div class="u-tile u-hero" style="left:480px;top:295px" data-s="1" data-tx="0" data-ty="0"><img data-src="/assets/gal-hero.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:720px;top:295px" data-s="0.6" data-tx="-94" data-ty="0"><img data-src="/assets/gal-c3.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:960px;top:295px" data-s="0.5" data-tx="-270" data-ty="0"><img data-src="/assets/gal-a4.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:0px;top:590px" data-s="0.5" data-tx="300" data-ty="-150"><img data-src="/assets/gal-b4.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:240px;top:590px" data-s="0.6" data-tx="124" data-ty="-90"><img data-src="/assets/gal-c4.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:480px;top:590px" data-s="0.7" data-tx="0" data-ty="-40"><img data-src="/assets/gal-a5.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:720px;top:590px" data-s="0.6" data-tx="-124" data-ty="-90"><img data-src="/assets/gal-b5.jpg" alt="" loading="lazy"></div>
      <div class="u-tile" style="left:960px;top:590px" data-s="0.5" data-tx="-300" data-ty="-150"><img data-src="/assets/gal-c5.jpg" alt="" loading="lazy"></div>
    </div>
  </div>
</section>
