---
// Signature Hero with atmospheric halo, Claude Coded badge, typing headline, dual CTAs, and interactive ticker
---

<div class="hero-zone">
  <header class="hero">
    <div class="hero-pill">
      <span class="hero-pill-chip">
        <img src="/assets/claude-icon.png" alt="Claude AI" width="16" height="16" />
        Claude Coded
      </span>
      <span class="hero-pill-text">
        <span class="hpt-full">Now get a working prototype in your phone!</span>
        <span class="hpt-short">Prototype in your phone!</span>
      </span>
    </div>
    
    <div class="hero-heading">
      <h1>Make Your App</h1>
      <p class="type-line">
        <span id="type-text"></span>
        <span class="type-cursor" aria-hidden="true"></span>
      </p>
    </div>
    
    <p class="hero-sub">
      Send screenshots or rough specs of your app. Get back investor-ready, high-converting interfaces and coded prototypes in days, not months.
    </p>
    
    <div style="display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 24px; flex-wrap: wrap;">
      <a class="btn-dark" href="/contact-us">
        <span class="btn-dark-label">Fix My App</span>
        <span class="btn-arrow">
          <img src="/assets/arrow.png" alt="" width="16" height="16" />
          <img src="/assets/arrow.png" alt="" width="16" height="16" />
        </span>
      </a>
      <a class="filter-btn" href="/work" style="padding: 14px 24px; font-size: 15px; border-radius: 999px;">
        Explore Solutions →
      </a>
    </div>
  </header>

  <!-- ============ HERO PHONE TICKER ============ -->
  <div class="hero-ticker-wrap">
    <div class="ticker" id="hero-ticker" data-speed="80" data-direction="ltr" data-arc="3200">
      <div class="ticker-track">
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="hush-home" src="/assets/screens/hush-home-after.jpg" data-fallback="/assets/phone-2.jpg" alt="Hush Home Screen" />
          </div>
        </div>
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="hush-chat" src="/assets/screens/hush-chat-after.jpg" data-fallback="/assets/phone-2.jpg" alt="Hush Chat Screen" />
          </div>
        </div>
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="founder" src="/assets/screens/founder-after.jpg" data-fallback="/assets/phone-4.jpg" alt="Founder Copilot Screen" />
          </div>
        </div>
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="fund" src="/assets/screens/fund-after.jpg" data-fallback="/assets/phone-5.jpg" alt="Fintech Screen" />
          </div>
        </div>
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="indus-home" src="/assets/screens/indus-home-after.jpg" data-fallback="/assets/phone-2.jpg" alt="Indus Onboarding Screen" />
          </div>
        </div>
        <div class="phone-card">
          <span class="ba-pill">After</span>
          <div class="phone-frame">
            <img data-screen="product" src="/assets/screens/product-after.jpg" data-fallback="/assets/phone-4.jpg" alt="Product Modernization Screen" />
          </div>
        </div>
      </div>
    </div>
    <div class="ticker ticker-gray" aria-hidden="true">
      <div class="ticker-track"></div>
    </div>
    <div class="hero-overlay">
      <div class="hero-overlay-bar"></div>
      <div class="hero-overlay-circles">
        <div class="circle-mid">
          <div class="circle-core">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 8l-4 4 4 4M15 8l4 4-4 4"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
