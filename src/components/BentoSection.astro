---
// Bento Features Section: Designed down to the details
---

<section class="bento" id="bento">
  <div class="bento-head">
    <span class="tag">
      <img loading="lazy" decoding="async" src="/assets/badge-features.png" alt="" width="14" height="14" />
      Engineering & Craft
    </span>
    <h2>Designed down<br><span class="blue">to the details.</span></h2>
  </div>

  <div class="bv2-grid">
    <!-- Tall Feature Card -->
    <div class="bv2-card bv2-tall">
      <span class="bv2-eyebrow">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/>
        </svg>
        World-Class Design
      </span>
      <h3 class="bv2-h">The polish you see in apps you envy. Now in yours.</h3>
      <div class="bv2-chips">
        <span>Glassmorphism</span>
        <span>Micro-interactions</span>
        <span>Bento Grids</span>
        <span>Motion Design</span>
      </div>
      <div class="bv2-screen">
        <img loading="lazy" decoding="async" src="/assets/screens/hush-home-after.jpg" alt="Polished UI screen" />
      </div>
    </div>

    <!-- Tidy Handoff Card -->
    <div class="bv2-card bv2-side">
      <span class="bv2-eyebrow">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/>
        </svg>
        Tidy Handoff
      </span>
      <h3 class="bv2-h">Your screens come back sorted.</h3>
      <div class="b3-folders">
        <div class="b3-folder" style="--fc:#aa26f2"><span class="b3-folder-name">Onboarding</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">10 screens</span></div>
        <div class="b3-folder" style="--fc:#ca7c0e"><span class="b3-folder-name">Auth</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">8 screens</span></div>
        <div class="b3-folder" style="--fc:#f25c26"><span class="b3-folder-name">Home</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">11 screens</span></div>
        <div class="b3-folder" style="--fc:#0c9618"><span class="b3-folder-name">Settings</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">5 screens</span></div>
        <div class="b3-folder" style="--fc:#6e73fa"><span class="b3-folder-name">Profile</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">21 screens</span></div>
        <div class="b3-folder" style="--fc:#71880a"><span class="b3-folder-name">Checkout</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">14 screens</span></div>
        <div class="b3-folder" style="--fc:#20a684"><span class="b3-folder-name">Search</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">4 screens</span></div>
        <div class="b3-folder" style="--fc:#0c5696"><span class="b3-folder-name">Paywall</span><img loading="lazy" decoding="async" class="b3-folder-r" src="/assets/logo.svg" alt=""><span class="b3-folder-count">9 screens</span></div>
      </div>
    </div>

    <!-- Claude Inside Card -->
    <div class="bv2-card bv2-side">
      <span class="bv2-eyebrow">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/>
        </svg>
        Claude Inside
      </span>
      <h3 class="bv2-h">AI Speed. Human Taste.</h3>
      <div class="b3-prompt">
        <div class="b3-avatar"><img loading="lazy" decoding="async" src="/assets/claude-icon.png" alt="Claude"></div>
        <div class="b3-promptbox">
          <p class="b3-ph"><span id="b3-type"></span><i class="b3-caret"></i></p>
          <div class="b3-prompt-bar">
            <span class="b3-model">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <path d="M12 3.2 19.6 7.6v8.8L12 20.8 4.4 16.4V7.6Z"/>
                <path d="M12 8.3l3.2 1.85v3.7L12 15.7l-3.2-1.85v-3.7Z"/>
              </svg>
              Claude 3.5
            </span>
            <span class="b3-actions">
              <button class="b3-attach" type="button" aria-label="Attach">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.5 7.5a2 2 0 0 1 2-2h3.6l2 2.4h7.4a2 2 0 0 1 2 2v7.6a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2Z"/>
                </svg>
              </button>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bento Bottom row -->
  <div class="bento-grid" style="margin-top: 24px;">
    <div class="bento-card">
      <p class="bento-cap"><strong>Tokens & Design System.</strong> Every color, radius, and font exported as code.</p>
      <div class="bento-stage">
        <div class="fan">
          <img loading="lazy" decoding="async" class="f1" src="/assets/phone-5.jpg" alt="Design System Phone 1">
          <img loading="lazy" decoding="async" class="f2" src="/assets/phone-4.jpg" alt="Design System Phone 2">
          <img loading="lazy" decoding="async" class="f3" src="/assets/phone-2.jpg" alt="Design System Phone 3">
        </div>
      </div>
      <div class="bento-pill">
        <svg viewBox="0 0 24 24" width="16" height="16" class="pill-ico">
          <rect x="3.5" y="3.5" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <rect x="13.5" y="3.5" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <rect x="3.5" y="13.5" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <rect x="13.5" y="13.5" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        Design system applied
        <span class="bento-pill-r">v2.0</span>
      </div>
    </div>

    <div class="bento-card">
      <p class="bento-cap"><strong>Know exactly what changed</strong> with verified visual diffs.</p>
      <div class="bento-stage" style="display:flex; align-items:center; justify-content:center; padding: 20px;">
        <div style="background:#ffffff; border-radius:14px; border:1px solid #e7eaf4; padding:18px 24px; box-shadow:0 4px 14px rgba(0,0,0,0.03); width:100%;">
          <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
            <span style="font-weight:700; font-size:13px; color:var(--ink-heading);">Git Revision Diff</span>
            <span style="font-size:12px; color:#22c55e; font-weight:700;">+1,420 lines modern CSS</span>
          </div>
          <div style="font-family:monospace; font-size:12px; color:var(--gray); line-height:1.6;">
            <div style="color:#ef4444;">- .w-row &#123; float: left; width: 33.33%; &#125;</div>
            <div style="color:#22c55e;">+ .card-grid &#123; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); &#125;</div>
          </div>
        </div>
      </div>
      <div class="bento-pill pill-purple">
        <span class="spark">✦</span>
        Deslopify tracked 2 changes
        <span class="bento-pill-r">2 new</span>
      </div>
    </div>
  </div>
</section>
