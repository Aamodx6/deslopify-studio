---
import faqData from '../data/faq.json';
---

<section class="faq-sec" id="faq" style="max-width: 900px; margin: 80px auto; padding: 0 24px;">
  <div style="text-align: center; margin-bottom: 48px;">
    <span class="tag">
      <img loading="lazy" decoding="async" src="/assets/badge-features.png" alt="" width="14" height="14">
      Frequently Asked Questions
    </span>
    <h2 style="font-family: var(--jakarta); font-size: clamp(30px, 4vw, 44px); font-weight: 800; color: var(--ink-heading); margin-top: 14px;">
      Got questions?<br><span class="blue">We have answers.</span>
    </h2>
  </div>

  <div class="faq-list" style="display: flex; flex-direction: column; gap: 14px;">
    {faqData.map((item) => (
      <details class="faq-item" style="background: #ffffff; border: 1px solid var(--card-gray); border-radius: 16px; padding: 20px 24px; transition: all 0.25s ease;">
        <summary style="font-family: var(--jakarta); font-size: 17px; font-weight: 700; color: var(--ink-heading); cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none;">
          <span>{item.q}</span>
          <span class="faq-icon" style="font-size: 20px; color: var(--blue); transition: transform 0.2s ease;">+</span>
        </summary>
        <p style="font-size: 15px; line-height: 1.65; color: var(--gray); margin-top: 14px; padding-top: 14px; border-top: 1px solid #f0f1f8;">
          {item.a}
        </p>
      </details>
    ))}
  </div>
</section>

<style>
  details[open] {
    border-color: var(--blue-soft) !important;
    box-shadow: 0 8px 24px rgba(38, 46, 242, 0.05);
  }
  details[open] .faq-icon {
    transform: rotate(45deg);
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
