---
// Showcase Section with working pill toggle, app-switcher tickers, and deep links
---

<section class="showcase" id="work">
  <div class="showcase-inner">
    <div class="showcase-head">
      <span class="tag">
        <img loading="lazy" decoding="async" src="/assets/badge-features.png" alt="" width="14" height="14" />
        Our Work
      </span>
      <h2>Real Apps.<br><span class="blue">Real Glow-Ups.</span></h2>
    </div>
    
    <div class="showcase-body">
      <div class="pill-toggle" id="pill-toggle">
        <span class="pill-thumb"></span>
        <button class="pill active">App design</button>
        <button class="pill">App store shots</button>
      </div>
      
      <div class="showcase-ticker-wrap">
        <!-- Project A: Founder Copilot -->
        <div class="ticker proj proj-a active" id="showcase-ticker" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-1.jpg" alt="Founder screen 1"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-2.jpg" alt="Founder screen 2"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-3.jpg" alt="Founder screen 3"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-4.jpg" alt="Founder screen 4"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-5.jpg" alt="Founder screen 5"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-6.jpg" alt="Founder screen 6"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" src="/assets/projects/founder-7.jpg" alt="Founder screen 7"></div></div>
          </div>
        </div>

        <!-- Project B: Indus Capital -->
        <div class="ticker proj proj-b" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-1.jpg" alt="Indus screen 1"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-2.jpg" alt="Indus screen 2"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-3.jpg" alt="Indus screen 3"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-4.jpg" alt="Indus screen 4"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-5.jpg" alt="Indus screen 5"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-6.jpg" alt="Indus screen 6"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/indus-7.jpg" alt="Indus screen 7"></div></div>
          </div>
        </div>

        <!-- Project C: Hush Audio -->
        <div class="ticker proj proj-c" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-1.jpg" alt="Hush splash"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-2.jpg" alt="Hush onboarding"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-3.jpg" alt="Hush phone number"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-4.jpg" alt="Hush home"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-5.jpg" alt="Hush chat"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-6.jpg" alt="Hush voice call"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-7.jpg" alt="Hush video call"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/hush-8.jpg" alt="Hush recent calls"></div></div>
          </div>
        </div>

        <!-- Project D: Sakurail Logistics -->
        <div class="ticker proj proj-d" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-1.jpg" alt="Sakurail welcome"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-2.jpg" alt="Sakurail journeys"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-3.jpg" alt="Sakurail arriving"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-4.jpg" alt="Sakurail platform map"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-5.jpg" alt="Sakurail seat selection"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/sakurail-6.jpg" alt="Sakurail profile"></div></div>
          </div>
        </div>

        <!-- Project E: Flyout Freight (Store) -->
        <div class="ticker proj proj-e" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-1.jpg" alt="Flyout home"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-2.jpg" alt="Flyout feed"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-3.jpg" alt="Flyout creators"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-4.jpg" alt="Flyout book"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-5.jpg" alt="Flyout reviews"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/flyout-6.jpg" alt="Flyout messages"></div></div>
          </div>
        </div>

        <!-- Project F: JustGains Fitness (Store) -->
        <div class="ticker proj proj-f" data-speed="80">
          <div class="ticker-track">
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/justgains-1.jpg" alt="Justgains shot 1"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/justgains-2.jpg" alt="Justgains shot 2"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/justgains-3.jpg" alt="Justgains shot 3"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/justgains-4.jpg" alt="Justgains shot 4"></div></div>
            <div class="shot-card"><div class="phone-frame"><img loading="lazy" decoding="async" data-src="/assets/projects/justgains-5.jpg" alt="Justgains shot 5"></div></div>
          </div>
        </div>

        <!-- App Switcher Dock -->
        <div class="app-icons" data-mode="design">
          <button class="app-icon sel" data-proj="a" aria-label="Founder Copilot">
            <img loading="lazy" decoding="async" src="/assets/app-icon-1.png" alt="Founder Copilot" title="Founder Copilot" />
          </button>
          <button class="app-icon" data-proj="b" aria-label="Indus Capital">
            <img loading="lazy" decoding="async" src="/assets/app-icon-2.png" alt="Indus Capital" title="Indus Capital" />
          </button>
          <button class="app-icon" data-proj="c" aria-label="Hush Audio">
            <img loading="lazy" decoding="async" src="/assets/app-icon-3.png" alt="Hush Audio" title="Hush Audio" />
          </button>
          <button class="app-icon" data-proj="d" aria-label="Sakurail Logistics">
            <img loading="lazy" decoding="async" src="/assets/projects/sakurail-icon.png" alt="Sakurail" title="Sakurail" />
          </button>
        </div>

        <div class="app-icons" data-mode="store">
          <button class="app-icon sel" data-proj="e" aria-label="Flyout Freight">
            <img loading="lazy" decoding="async" src="/assets/projects/flyout-icon.jpg" alt="Flyout Freight" title="Flyout Freight" />
          </button>
          <button class="app-icon" data-proj="f" aria-label="JustGains Health">
            <img loading="lazy" decoding="async" src="/assets/projects/justgains-icon.jpg" alt="JustGains" title="JustGains" />
          </button>
        </div>
      </div>

      <div style="text-align: center; margin-top: 36px;">
        <a class="filter-btn active" href="/work" style="padding: 12px 28px; font-size: 15px; display: inline-flex; align-items: center; gap: 8px;">
          View All Case Studies & Filter by Category →
        </a>
      </div>
    </div>
  </div>
</section>
