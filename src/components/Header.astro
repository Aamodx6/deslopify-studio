---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/services-detail', label: 'Architecture' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about-us', label: 'About' },
  { href: '/blog', label: 'Insights' },
];
---

<header>
  <nav class="nav" id="site-nav">
    <a class="nav-logo" href="/">
      <img src="/assets/logo.svg" alt="Deslopify Logo" width="28" height="28" />
      <span>Deslopify</span>
    </a>
    
    <div class="nav-links">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a href={link.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            {link.label}
          </a>
        );
      })}
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
      <a class="nav-cta" href="/#book">Book a call</a>
      
      <!-- Mobile hamburger toggle button -->
      <button class="hamburger-btn" id="mobile-toggle-btn" aria-label="Open Navigation Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile slide-out drawer -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay">
    <div class="mobile-drawer">
      <div class="mobile-drawer-head">
        <a class="nav-logo" href="/">
          <img src="/assets/logo.svg" alt="Deslopify" width="28" height="28" />
          <span>Deslopify</span>
        </a>
        <button id="mobile-close-btn" style="background:none; border:none; padding:6px; cursor:pointer;" aria-label="Close Navigation Menu">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <div class="mobile-nav-links">
        <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a href={link.href} class={`mobile-nav-link ${isActive ? 'active' : ''}`}>
              {link.label}
            </a>
          );
        })}
        <div style="margin-top: 24px;">
          <a class="submit-btn-primary" href="/#book">
            Book a Project Call
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer interaction script
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const overlay = document.getElementById('mobile-menu-overlay');

  if (toggleBtn && overlay && closeBtn) {
    toggleBtn.addEventListener('click', () => {
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
    
    closeBtn.addEventListener('click', () => {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    });

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  }
</script>
